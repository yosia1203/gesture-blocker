{
  "manifest_version": 3,
  "name": "Gesture Blocker",
  "version": "1.2.0",
  "description": "Block trackpad swipe back/forward and pinch-zoom on the sites you choose.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "16": "icons/active/icon16.png",
    "32": "icons/active/icon32.png",
    "48": "icons/active/icon48.png",
    "128": "icons/store-icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gesture Blocker",
    "default_icon": {
      "16": "icons/inactive/icon16.png",
      "32": "icons/inactive/icon32.png",
      "48": "icons/inactive/icon48.png",
      "128": "icons/inactive/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
